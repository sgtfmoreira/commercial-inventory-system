{
  "name": "bastidor-os-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "styled-components": "^6.1.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "check:encoding": "node scripts/check-text-encoding.js",
    "check:ui": "node scripts/check-ui-components.js",
    "prebuild": "npm run check:encoding && npm run check:ui",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:stock-movement": "jest --config scripts/stock-movement-jest.config.js --runInBand",
    "test:events": "jest --config scripts/events-jest.config.js --runInBand",
    "test:table-reservations": "jest --config scripts/table-reservations-jest.config.js --runInBand",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
