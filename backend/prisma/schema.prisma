generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////////////
//////////////////// ENUMS //////////////////////////////////
////////////////////////////////////////////////////////////

enum ProductType {
  INVENTORY
  PRODUCTION
  ASSET
}

enum PurchaseClassification {
  CMV_BEVERAGES
  CLEANING
  DISPOSABLES
  OPERATING
  EXCLUDED
}

enum RestockFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ON_DEMAND
}

////////////////////////////////////////////////////////////
//////////////////// SUPPLIERS //////////////////////////////
////////////////////////////////////////////////////////////

model Supplier {
  id    String  @id @default(uuid()) @db.Uuid
  name  String
  cnpj  String?
  phone String?
  email String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  organizationSupplierId String?               @db.Uuid
  organizationSupplier   OrganizationSupplier? @relation(fields: [organizationSupplierId], references: [id])

  createdAt        DateTime            @default(now())
  orderItems       PurchaseOrderItem[]
  productSuppliers ProductSupplier[]

  priceHistory         SupplierPriceHistory[]
  stockMovements       StockMovement[]
  commercialAgreements CommercialAgreement[]
  purchaseInvoices     PurchaseInvoice[]
  bonusReceipts        BonusReceipt[]
  inventoryLots        InventoryLot[]

  @@unique([establishmentId, organizationSupplierId])
  @@index([organizationSupplierId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  products Product[]

  @@unique([name, establishmentId])
  @@map("categories")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  unit      String
  unitPrice Decimal? @db.Decimal(12, 4)
  salePrice Decimal? @db.Decimal(12, 4)

  quantity    Decimal @default(0) @db.Decimal(12, 3)
  minQuantity Decimal @default(0) @db.Decimal(12, 3)

  type ProductType @default(INVENTORY)

  purchaseUnit String?
  packQuantity Float?  @default(1)

  currentCost Decimal? @db.Decimal(12, 4)

  isActive Boolean @default(true)

  purchaseClassification PurchaseClassification @default(CMV_BEVERAGES)
  restockFrequency       RestockFrequency       @default(ON_DEMAND)
  idealQuantity          Decimal                @default(0) @db.Decimal(12, 3)
  trackInventory         Boolean                @default(true)
  responsibleSector      String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  organizationProductId String?              @db.Uuid
  organizationProduct   OrganizationProduct? @relation(fields: [organizationProductId], references: [id])

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  defaultLocationId String?        @db.Uuid
  defaultLocation   StockLocation? @relation("ProductDefaultLocation", fields: [defaultLocationId], references: [id])

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  auditItems                  StockAuditItem[]
  orderItems                  PurchaseOrderItem[]
  stockMovements              StockMovement[]
  productSuppliers            ProductSupplier[]
  supplierPriceHistory        SupplierPriceHistory[]
  recipeItems                 RecipeItem[]
  Recipe                      Recipe?
  transfersAsSource           StockTransfer[]              @relation("TransferSourceProduct")
  transfersAsDestination      StockTransfer[]              @relation("TransferDestinationProduct")
  consumptionEventItems       ConsumptionEventItem[]
  productionOrders            ProductionOrder[]
  productStocks               ProductStock[]
  portioningRecipesAsSource   PortioningRecipe?            @relation("PortioningSourceProduct")
  portioningRecipeItems       PortioningRecipeItem[]       @relation("PortioningTargetProduct")
  portioningOrdersAsSource    PortioningOrder[]            @relation("PortioningOrderSourceProduct")
  portioningOrderItems        PortioningOrderItem[]        @relation("PortioningOrderTargetProduct")
  saleItems                   SaleItem[]
  commercialAgreementProducts CommercialAgreementProduct[]
  purchaseInvoiceItems        PurchaseInvoiceItem[]
  bonusReceiptItems           BonusReceiptItem[]
  inventoryLots               InventoryLot[]

  @@unique([establishmentId, organizationProductId])
  @@index([establishmentId, purchaseClassification])
  @@index([organizationProductId])
  @@map("products")
}

model PurchaseOrder {
  id          String    @id @default(uuid()) @db.Uuid
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user_id String @db.Uuid
  users   users  @relation(fields: [user_id], references: [id])

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  items   PurchaseOrderItem[]
  invoice PurchaseInvoice?

  @@index([establishmentId])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  productId       String? @db.Uuid
  supplierId      String? @db.Uuid

  productName            String
  adjustedQuantity       Decimal                @db.Decimal(12, 3)
  unitPrice              Decimal                @db.Decimal(12, 4)
  purchaseClassification PurchaseClassification @default(CMV_BEVERAGES)

  createdAt DateTime @default(now())

  receivedStockQuantity Decimal? @db.Decimal(12, 3)
  receivedUnitCost      Decimal? @db.Decimal(12, 4)
  receivedUnit          String?
  returns               PurchaseReturn[]
  inventoryLot          InventoryLot?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([purchaseClassification])
  @@map("purchase_order_items")
}

model PurchaseReturn {
  id                  String @id @default(uuid()) @db.Uuid
  establishmentId     String @db.Uuid
  requestId           String @db.Uuid
  purchaseOrderItemId  String @db.Uuid
  purchaseOrderItem    PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  stockMovementId     String @unique @db.Uuid
  stockMovement       StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  quantity            Decimal @db.Decimal(12, 3)
  purchaseQuantity    Decimal @db.Decimal(18, 9)
  unitCost            Decimal @db.Decimal(12, 4)
  totalCost           Decimal @db.Decimal(14, 4)
  returnedAt          DateTime
  createdAt           DateTime @default(now())
  recordedByUserId    String @db.Uuid
  reason              String
  financialTreatment  String @default("PENDING")
  notes               String?

  @@unique([establishmentId, requestId])
  @@index([establishmentId, returnedAt])
  @@index([purchaseOrderItemId])
  @@map("purchase_returns")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])

  productName String
  type        String

  quantity         Decimal @db.Decimal(12, 3)
  previousQuantity Decimal @db.Decimal(12, 3)
  newQuantity      Decimal @db.Decimal(12, 3)

  reference       String
  reason          String?
  createdAt       DateTime       @default(now())
  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])
  unitCost        Decimal?       @db.Decimal(12, 4)
  totalCost       Decimal?       @db.Decimal(14, 4)
  supplierId      String?        @db.Uuid
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])

  locationId String?        @db.Uuid
  location   StockLocation? @relation(fields: [locationId], references: [id])

  saleId String? @db.Uuid
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  purchaseClassification PurchaseClassification?
  responsibleSector      String?
  notes                  String?
  periodFrom             DateTime?
  periodTo               DateTime?
  recordedByUserId       String?                 @db.Uuid
  purchaseReturn        PurchaseReturn?

  @@index([establishmentId])
  @@index([productId])
  @@index([createdAt])
  @@index([saleId])
  @@index([establishmentId, purchaseClassification, createdAt])
  @@index([establishmentId, createdAt, id])
  @@map("stock_movements")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actionType  String
  entityType  String
  entityId    String
  description String

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([establishmentId])
  @@index([createdAt])
  @@map("audit_logs")
}

model establishments {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  cnpj     String?
  telefone String?
  endereco String?
  cidade   String?
  estado   String?

  users          UserEstablishment[]
  products       Product[]
  suppliers      Supplier[]
  categories     Category[]
  auditLogs      AuditLog[]
  recipes        Recipe[]
  stockAudits    StockAudit[]
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id])

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  transfersFrom        StockTransfer[]       @relation("TransferFrom")
  transfersTo          StockTransfer[]       @relation("TransferTo")
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  consumptionEvents    ConsumptionEvent[]
  productionOrders     ProductionOrder[]
  stockLocations       StockLocation[]
  portioningRecipes    PortioningRecipe[]
  portioningOrders     PortioningOrder[]
  sales                Sale[]
  commercialAgreements CommercialAgreement[]
  purchaseInvoices     PurchaseInvoice[]
  bonusReceipts        BonusReceipt[]
  inventoryLots        InventoryLot[]
}

model users {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  establishments   UserEstablishment[]
  stockAudits      StockAudit[]
  purchase_orders  PurchaseOrder[]
  productionOrders ProductionOrder[]
  portioningOrders PortioningOrder[]
}

model Sale {
  id              String          @id @default(uuid()) @db.Uuid
  establishmentId String          @db.Uuid
  establishment   establishments  @relation(fields: [establishmentId], references: [id])
  source          String
  status          String          @default("COMPLETED")
  externalId      String?
  grossTotal      Decimal?        @db.Decimal(14, 2)
  discountTotal   Decimal?        @db.Decimal(14, 2)
  netTotal        Decimal?        @db.Decimal(14, 2)
  costTotal       Decimal         @default(0) @db.Decimal(14, 4)
  soldAt          DateTime        @default(now())
  createdAt       DateTime        @default(now())
  items           SaleItem[]
  stockMovements  StockMovement[]

  @@unique([establishmentId, source, externalId])
  @@index([establishmentId, soldAt])
  @@index([establishmentId, status, soldAt])
  @@map("sales")
}

model SaleItem {
  id            String   @id @default(uuid()) @db.Uuid
  saleId        String   @db.Uuid
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String?  @db.Uuid
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  quantity      Decimal  @db.Decimal(12, 3)
  unitSalePrice Decimal? @db.Decimal(12, 4)
  grossTotal    Decimal? @db.Decimal(14, 2)
  discountTotal Decimal? @db.Decimal(14, 2)
  netTotal      Decimal? @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum CommercialAgreementStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BonusReceiptStatus {
  RECEIVED
  CANCELLED
}

model CommercialAgreement {
  id                 String                       @id @default(uuid()) @db.Uuid
  establishmentId    String                       @db.Uuid
  establishment      establishments               @relation(fields: [establishmentId], references: [id])
  supplierId         String                       @db.Uuid
  supplier           Supplier                     @relation(fields: [supplierId], references: [id])
  name               String
  brand              String?
  buyQuantity        Decimal                      @db.Decimal(12, 3)
  bonusQuantity      Decimal                      @db.Decimal(12, 3)
  currentRemainder   Decimal                      @default(0) @db.Decimal(12, 3)
  allowMixedProducts Boolean                      @default(true)
  startsAt           DateTime
  endsAt             DateTime?
  status             CommercialAgreementStatus    @default(ACTIVE)
  notes              String?
  createdByUserId    String                       @db.Uuid
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  products           CommercialAgreementProduct[]
  accruals           BonusAccrual[]
  receipts           BonusReceipt[]

  @@index([establishmentId, status])
  @@index([supplierId, status])
  @@map("commercial_agreements")
}

model CommercialAgreementProduct {
  id                   String              @id @default(uuid()) @db.Uuid
  agreementId          String              @db.Uuid
  agreement            CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  productId            String              @db.Uuid
  product              Product             @relation(fields: [productId], references: [id])
  eligibilityFactor    Decimal             @default(1) @db.Decimal(12, 4)
  canGenerateBonus     Boolean             @default(true)
  canBeReceivedAsBonus Boolean             @default(true)

  @@unique([agreementId, productId])
  @@index([productId])
  @@map("commercial_agreement_products")
}

model PurchaseInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  establishmentId String                @db.Uuid
  establishment   establishments        @relation(fields: [establishmentId], references: [id])
  supplierId      String                @db.Uuid
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrderId String                @unique @db.Uuid
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  invoiceNumber   String
  invoiceSeries   String                @default("")
  issuedAt        DateTime
  receivedAt      DateTime              @default(now())
  netPaidAmount   Decimal?              @db.Decimal(14, 2)
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())
  items           PurchaseInvoiceItem[]
  accruals        BonusAccrual[]

  @@unique([establishmentId, supplierId, invoiceNumber, invoiceSeries])
  @@index([establishmentId, issuedAt])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id        String          @id @default(uuid()) @db.Uuid
  invoiceId String          @db.Uuid
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Decimal         @db.Decimal(12, 3)
  unitPrice Decimal         @db.Decimal(12, 4)
  createdAt DateTime        @default(now())

  @@index([invoiceId])
  @@index([productId])
  @@map("purchase_invoice_items")
}

model BonusAccrual {
  id                  String              @id @default(uuid()) @db.Uuid
  agreementId         String              @db.Uuid
  agreement           CommercialAgreement @relation(fields: [agreementId], references: [id])
  invoiceId           String              @db.Uuid
  invoice             PurchaseInvoice     @relation(fields: [invoiceId], references: [id])
  eligibleQuantity    Decimal             @db.Decimal(12, 3)
  balanceBefore       Decimal             @db.Decimal(12, 3)
  earnedBonusQuantity Decimal             @db.Decimal(12, 3)
  balanceAfter        Decimal             @db.Decimal(12, 3)
  createdAt           DateTime            @default(now())

  @@unique([agreementId, invoiceId])
  @@index([agreementId, createdAt])
  @@map("bonus_accruals")
}

model BonusReceipt {
  id                String              @id @default(uuid()) @db.Uuid
  establishmentId   String              @db.Uuid
  establishment     establishments      @relation(fields: [establishmentId], references: [id])
  supplierId        String              @db.Uuid
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  agreementId       String              @db.Uuid
  agreement         CommercialAgreement @relation(fields: [agreementId], references: [id])
  invoiceNumber     String
  invoiceSeries     String              @default("")
  invoiceDate       DateTime
  additionalCredits Decimal             @default(0) @db.Decimal(14, 2)
  status            BonusReceiptStatus  @default(RECEIVED)
  createdByUserId   String              @db.Uuid
  createdAt         DateTime            @default(now())
  items             BonusReceiptItem[]

  @@unique([establishmentId, supplierId, invoiceNumber, invoiceSeries])
  @@index([agreementId, invoiceDate])
  @@map("bonus_receipts")
}

model BonusReceiptItem {
  id                       String       @id @default(uuid()) @db.Uuid
  bonusReceiptId           String       @db.Uuid
  bonusReceipt             BonusReceipt @relation(fields: [bonusReceiptId], references: [id], onDelete: Cascade)
  productId                String       @db.Uuid
  product                  Product      @relation(fields: [productId], references: [id])
  locationId               String       @db.Uuid
  quantity                 Decimal      @db.Decimal(12, 3)
  fiscalUnitPrice          Decimal      @db.Decimal(12, 4)
  commercialReferencePrice Decimal      @db.Decimal(12, 4)
  fiscalTotal              Decimal      @db.Decimal(14, 2)
  commercialBenefit        Decimal      @db.Decimal(14, 2)
  createdAt                DateTime     @default(now())

  @@index([bonusReceiptId])
  @@index([productId])
  @@map("bonus_receipt_items")
}

model ProductSupplier {
  id String @id @default(uuid()) @db.Uuid

  productId  String @db.Uuid
  supplierId String @db.Uuid

  price Decimal @default(0) @db.Decimal(12, 4)

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model SupplierPriceHistory {
  id String @id @default(uuid()) @db.Uuid

  productId  String @db.Uuid
  supplierId String @db.Uuid

  price Decimal @db.Decimal(12, 4)

  purchaseOrderId String? @db.Uuid

  createdAt DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@map("supplier_price_history")
}

model Recipe {
  id String @id @default(uuid()) @db.Uuid

  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  items RecipeItem[]

  yieldQuantity Decimal @default(1) @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@map("recipes")
}

model RecipeItem {
  id String @id @default(uuid()) @db.Uuid

  recipeId String @db.Uuid
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@unique([recipeId, productId])
  @@map("recipe_items")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  establishments      establishments[]
  products            OrganizationProduct[]
  productCodeSequence OrganizationProductSequence?
  productReviews      OrganizationProductReview[]
  suppliers           OrganizationSupplier[]
  supplierReviews     OrganizationSupplierReview[]
}

model OrganizationSupplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String
  name           String
  legalName      String?
  cnpj           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id])
  localSuppliers Supplier[]
  catalogItems   SupplierCatalogItem[]
  priceUpdates   SupplierPriceUpdate[]
  portalUsers    SupplierPortalUser[]

  @@index([organizationId])
  @@index([organizationId, cnpj])
  @@map("organization_suppliers")
}

model SupplierPortalUser {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationSupplierId String    @db.Uuid
  name                   String
  email                  String    @unique
  passwordHash           String
  isActive               Boolean   @default(true)
  isBlocked              Boolean   @default(false)
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  revokedAt              DateTime?
  sessionVersion         Int       @default(1)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organizationSupplier OrganizationSupplier @relation(fields: [organizationSupplierId], references: [id])

  @@index([organizationSupplierId, isActive])
  @@map("supplier_portal_users")
}

model OrganizationSupplierReview {
  id                            String    @id @default(uuid()) @db.Uuid
  organizationId                String
  candidateKey                  String
  status                        String
  supplierIds                   Json
  suggestedName                 String
  normalizedCnpj                String
  appliedOrganizationSupplierId String?   @db.Uuid
  reviewedByUserId              String?   @db.Uuid
  reviewedAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, candidateKey])
  @@index([organizationId, status])
  @@map("organization_supplier_reviews")
}

model OrganizationProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String
  internalCode   String
  name           String
  brand          String?
  baseUnit       String
  barcode        String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  localProducts        Product[]
  supplierCatalogItems SupplierCatalogItem[]

  @@unique([organizationId, internalCode])
  @@index([organizationId, barcode])
  @@map("organization_products")
}

model SupplierCatalogItem {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationSupplierId String    @db.Uuid
  organizationProductId  String    @db.Uuid
  supplierCode           String?
  commercialUnit         String
  unitsPerPackage        Decimal   @db.Decimal(12, 3)
  packagePrice           Decimal   @db.Decimal(12, 4)
  normalizedUnitPrice    Decimal   @db.Decimal(12, 4)
  available              Boolean   @default(true)
  minimumOrder           Decimal?  @db.Decimal(12, 3)
  deliveryLeadDays       Int?
  validUntil             DateTime?
  status                 String    @default("ACTIVE")
  lastSubmittedAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organizationSupplier OrganizationSupplier      @relation(fields: [organizationSupplierId], references: [id])
  organizationProduct  OrganizationProduct       @relation(fields: [organizationProductId], references: [id])
  updateItems          SupplierPriceUpdateItem[]

  @@unique([organizationSupplierId, organizationProductId])
  @@index([organizationProductId])
  @@map("supplier_catalog_items")
}

model SupplierPriceUpdate {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationSupplierId String    @db.Uuid
  status                 String    @default("DRAFT")
  note                   String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  appliedAt              DateTime?
  approvedByUserId       String?   @db.Uuid
  createdByUserId        String?   @db.Uuid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organizationSupplier OrganizationSupplier      @relation(fields: [organizationSupplierId], references: [id])
  items                SupplierPriceUpdateItem[]

  @@index([organizationSupplierId, status])
  @@index([createdAt, id])
  @@map("supplier_price_updates")
}

model SupplierPriceUpdateItem {
  id                      String   @id @default(uuid()) @db.Uuid
  supplierPriceUpdateId   String   @db.Uuid
  supplierCatalogItemId   String   @db.Uuid
  previousPackagePrice    Decimal  @db.Decimal(12, 4)
  newPackagePrice         Decimal  @db.Decimal(12, 4)
  previousNormalizedPrice Decimal  @db.Decimal(12, 4)
  newNormalizedPrice      Decimal  @db.Decimal(12, 4)
  commercialUnit          String
  unitsPerPackage         Decimal  @db.Decimal(12, 3)
  available               Boolean
  deliveryLeadDays        Int?
  status                  String   @default("PENDING")
  rejectionReason         String?
  affectedEstablishments  Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  update      SupplierPriceUpdate @relation(fields: [supplierPriceUpdateId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem @relation(fields: [supplierCatalogItemId], references: [id])

  @@unique([supplierPriceUpdateId, supplierCatalogItemId])
  @@index([supplierCatalogItemId])
  @@map("supplier_price_update_items")
}

model OrganizationProductSequence {
  organizationId String @id
  currentValue   Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_product_sequences")
}

model OrganizationProductReview {
  id                           String    @id @default(uuid()) @db.Uuid
  organizationId               String
  candidateKey                 String
  status                       String
  productIds                   Json
  suggestedName                String
  appliedOrganizationProductId String?   @db.Uuid
  reviewedByUserId             String?   @db.Uuid
  reviewedAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, candidateKey])
  @@index([organizationId, status])
  @@map("organization_product_reviews")
}

model StockTransfer {
  id String @id @default(uuid()) @db.Uuid

  productId            String  @db.Uuid
  destinationProductId String? @db.Uuid
  quantity             Float

  fromEstablishmentId String @db.Uuid
  toEstablishmentId   String @db.Uuid

  status TransferStatus @default(PENDING)

  createdBy  String  @db.Uuid
  approvedBy String? @db.Uuid

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  product            Product  @relation("TransferSourceProduct", fields: [productId], references: [id])
  destinationProduct Product? @relation("TransferDestinationProduct", fields: [destinationProductId], references: [id])

  fromEstablishment establishments @relation("TransferFrom", fields: [fromEstablishmentId], references: [id])
  toEstablishment   establishments @relation("TransferTo", fields: [toEstablishmentId], references: [id])
}

model UserEstablishment {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @db.Uuid
  establishmentId String @db.Uuid

  role      String // ex: ADMIN, MANAGER, STAFF
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user          users          @relation(fields: [userId], references: [id])
  establishment establishments @relation(fields: [establishmentId], references: [id])

  @@unique([userId, establishmentId])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockAudit {
  id String @id @default(uuid()) @db.Uuid

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdBy String @db.Uuid
  user      users  @relation(fields: [createdBy], references: [id])

  status String @default("OPEN")

  createdAt DateTime  @default(now())
  countedAt DateTime?

  items StockAuditItem[]

  @@index([establishmentId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("stock_audits")
}

model StockAuditItem {
  id String @id @default(uuid()) @db.Uuid

  auditId String     @db.Uuid
  audit   StockAudit @relation(fields: [auditId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  systemQuantity Decimal @db.Decimal(12, 3)

  countedQuantity Decimal @default(0) @db.Decimal(12, 3)

  difference Decimal @default(0) @db.Decimal(12, 3)

  locationId String?        @db.Uuid
  location   StockLocation? @relation(fields: [locationId], references: [id])

  @@map("stock_audit_items")
}

model ConsumptionEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String
  status          String                 @default("OPEN") // OPEN, CLOSED
  establishmentId String                 @db.Uuid
  establishment   establishments         @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime               @default(now())
  completedAt     DateTime?
  items           ConsumptionEventItem[]

  @@index([establishmentId])
  @@map("consumption_events")
}

model ConsumptionEventItem {
  id           String           @id @default(uuid()) @db.Uuid
  eventId      String           @db.Uuid
  event        ConsumptionEvent @relation(fields: [eventId], references: [id])
  productId    String           @db.Uuid
  product      Product          @relation(fields: [productId], references: [id])
  withdrawnQty Decimal          @db.Decimal(12, 3) // em unidades base (ml/g)
  returnedQty  Decimal          @default(0) @db.Decimal(12, 3) // em unidades base (ml/g)
  unitCost     Decimal          @db.Decimal(12, 4) // custo unitário no momento da retirada

  createdAt DateTime @default(now())

  locationId String?        @db.Uuid
  location   StockLocation? @relation(fields: [locationId], references: [id])

  @@index([eventId])
  @@index([productId])
  @@map("consumption_event_items")
}

////////////////////////////////////////////////////////////
//////////////////// PRODUCTION ////////////////////////////
////////////////////////////////////////////////////////////

enum ProductionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  status ProductionStatus @default(PENDING)

  notes String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdBy String @db.Uuid
  user      users  @relation(fields: [createdBy], references: [id])

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([establishmentId])
  @@index([createdAt])
  @@index([status])
  @@map("production_orders")
}

model StockLocation {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  isDefault       Boolean        @default(false)
  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime       @default(now())

  productStocks    ProductStock[]
  stockMovements   StockMovement[]
  auditItems       StockAuditItem[]
  consumptionItems ConsumptionEventItem[]
  products         Product[]              @relation("ProductDefaultLocation")

  @@unique([name, establishmentId])
  @@map("stock_locations")
}

model ProductStock {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  locationId String  @db.Uuid
  quantity   Decimal @default(0) @db.Decimal(12, 3)

  product  Product       @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
  @@map("product_stocks")
}

////////////////////////////////////////////////////////////
//////////////////// PORTIONING / DESOSSA //////////////////
////////////////////////////////////////////////////////////

model PortioningRecipe {
  id String @id @default(uuid()) @db.Uuid

  sourceProductId String  @unique @db.Uuid
  sourceProduct   Product @relation("PortioningSourceProduct", fields: [sourceProductId], references: [id])

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  items PortioningRecipeItem[]

  createdAt DateTime @default(now())

  @@map("portioning_recipes")
}

model PortioningRecipeItem {
  id String @id @default(uuid()) @db.Uuid

  portioningRecipeId String           @db.Uuid
  portioningRecipe   PortioningRecipe @relation(fields: [portioningRecipeId], references: [id], onDelete: Cascade)

  targetProductId String  @db.Uuid
  targetProduct   Product @relation("PortioningTargetProduct", fields: [targetProductId], references: [id])

  costAllocationPercentage Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@unique([portioningRecipeId, targetProductId])
  @@map("portioning_recipe_items")
}

model PortioningOrder {
  id String @id @default(uuid()) @db.Uuid

  sourceProductId String  @db.Uuid
  sourceProduct   Product @relation("PortioningOrderSourceProduct", fields: [sourceProductId], references: [id])

  sourceQuantity Decimal @db.Decimal(12, 3)

  sourceLotId String?       @db.Uuid
  sourceLot   InventoryLot? @relation(fields: [sourceLotId], references: [id], onDelete: Restrict)

  status ProductionStatus @default(PENDING)

  notes String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdBy String @db.Uuid
  user      users  @relation(fields: [createdBy], references: [id])

  items PortioningOrderItem[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([establishmentId])
  @@index([createdAt])
  @@index([status])
  @@index([sourceLotId])
  @@map("portioning_orders")
}

model PortioningOrderItem {
  id String @id @default(uuid()) @db.Uuid

  portioningOrderId String          @db.Uuid
  portioningOrder   PortioningOrder @relation(fields: [portioningOrderId], references: [id], onDelete: Cascade)

  targetProductId String  @db.Uuid
  targetProduct   Product @relation("PortioningOrderTargetProduct", fields: [targetProductId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  netWeightKg Decimal? @db.Decimal(12, 3)

  costAllocationPercentage Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@map("portioning_order_items")
}

model InventoryLot {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  purchaseOrderItemId String            @unique @db.Uuid
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  initialQuantity   Decimal  @db.Decimal(12, 3)
  remainingQuantity Decimal  @db.Decimal(12, 3)
  unit              String
  receivedAt        DateTime
  createdAt         DateTime @default(now())

  portioningOrders PortioningOrder[]

  @@index([establishmentId, productId, receivedAt])
  @@index([establishmentId, remainingQuantity])
  @@map("inventory_lots")
}
