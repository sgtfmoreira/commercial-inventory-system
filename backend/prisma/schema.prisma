generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////////////
//////////////////// ENUMS //////////////////////////////////
////////////////////////////////////////////////////////////

enum ProductType {
  INVENTORY
  PRODUCTION
  ASSET
}

enum PurchaseClassification {
  CMV_BEVERAGES
  CLEANING
  DISPOSABLES
  OPERATING
  EXCLUDED
}

enum RestockFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ON_DEMAND
}

enum CommercialEventStatus {
  DRAFT
  BUDGETING
  APPROVED
  PLANNING_PENDING
  CANCELLED
}

enum CommercialEventType {
  CORPORATE
  WEDDING
  BIRTHDAY
  GRADUATION
  GET_TOGETHER
  CATERING
  INTERNAL
  OTHER
}

enum EventBudgetStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum EventBudgetItemType {
  RECIPE
  PRODUCT
  MANUAL
  STAFF
  SERVICE
  EQUIPMENT
  TRANSPORT
  FEE
  OTHER
}

enum EventBudgetCostGroup {
  MENU
  STAFF
  SERVICE
  EQUIPMENT
  TRANSPORT
  FEE
  OTHER
}

enum EventQuantityMode {
  FIXED
  PER_GUEST
}

enum OrganizationSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  LEGACY
}

enum AuthorizationMode {
  LEGACY
  PROFILED
}

enum AccessProfileCode {
  OWNER
  ADMINISTRATOR
  MANAGER
  SUPERVISOR
  COLLABORATOR
  AUDITOR
}

enum AccessConfigurationStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum OrganizationAuthorityType {
  OWNER
}

////////////////////////////////////////////////////////////
//////////////////// SUPPLIERS //////////////////////////////
////////////////////////////////////////////////////////////

model Supplier {
  id    String  @id @default(uuid()) @db.Uuid
  name  String
  cnpj  String?
  phone String?
  email String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  organizationSupplierId String?               @db.Uuid
  organizationSupplier   OrganizationSupplier? @relation(fields: [organizationSupplierId], references: [id])

  createdAt        DateTime            @default(now())
  orderItems       PurchaseOrderItem[]
  productSuppliers ProductSupplier[]

  priceHistory         SupplierPriceHistory[]
  stockMovements       StockMovement[]
  commercialAgreements CommercialAgreement[]
  purchaseInvoices     PurchaseInvoice[]
  bonusReceipts        BonusReceipt[]
  inventoryLots        InventoryLot[]

  @@unique([establishmentId, organizationSupplierId])
  @@index([organizationSupplierId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  products Product[]

  @@unique([name, establishmentId])
  @@map("categories")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  unit      String
  unitPrice Decimal? @db.Decimal(12, 4)
  salePrice Decimal? @db.Decimal(12, 4)

  quantity    Decimal @default(0) @db.Decimal(12, 3)
  minQuantity Decimal @default(0) @db.Decimal(12, 3)

  type ProductType @default(INVENTORY)

  purchaseUnit String?
  packQuantity Float?  @default(1)

  currentCost Decimal? @db.Decimal(12, 4)

  isActive Boolean @default(true)

  purchaseClassification PurchaseClassification @default(CMV_BEVERAGES)
  restockFrequency       RestockFrequency       @default(ON_DEMAND)
  idealQuantity          Decimal                @default(0) @db.Decimal(12, 3)
  trackInventory         Boolean                @default(true)
  responsibleSector      String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  organizationProductId String?              @db.Uuid
  organizationProduct   OrganizationProduct? @relation(fields: [organizationProductId], references: [id])

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  defaultLocationId String?        @db.Uuid
  defaultLocation   StockLocation? @relation("ProductDefaultLocation", fields: [defaultLocationId], references: [id])

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  auditItems                  StockAuditItem[]
  orderItems                  PurchaseOrderItem[]
  stockMovements              StockMovement[]
  productSuppliers            ProductSupplier[]
  supplierPriceHistory        SupplierPriceHistory[]
  recipeItems                 RecipeItem[]
  Recipe                      Recipe?
  transfersAsSource           StockTransfer[]              @relation("TransferSourceProduct")
  transfersAsDestination      StockTransfer[]              @relation("TransferDestinationProduct")
  consumptionEventItems       ConsumptionEventItem[]
  productionOrders            ProductionOrder[]
  productStocks               ProductStock[]
  portioningRecipesAsSource   PortioningRecipe?            @relation("PortioningSourceProduct")
  portioningRecipeItems       PortioningRecipeItem[]       @relation("PortioningTargetProduct")
  portioningOrdersAsSource    PortioningOrder[]            @relation("PortioningOrderSourceProduct")
  portioningOrderItems        PortioningOrderItem[]        @relation("PortioningOrderTargetProduct")
  saleItems                   SaleItem[]
  commercialAgreementProducts CommercialAgreementProduct[]
  purchaseInvoiceItems        PurchaseInvoiceItem[]
  bonusReceiptItems           BonusReceiptItem[]
  inventoryLots               InventoryLot[]

  @@unique([establishmentId, organizationProductId])
  @@index([establishmentId, purchaseClassification])
  @@index([organizationProductId])
  @@map("products")
}

model PurchaseOrder {
  id          String    @id @default(uuid()) @db.Uuid
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user_id String @db.Uuid
  users   users  @relation(fields: [user_id], references: [id])

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  items   PurchaseOrderItem[]
  invoice PurchaseInvoice?

  @@index([establishmentId])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  productId       String? @db.Uuid
  supplierId      String? @db.Uuid

  productName            String
  adjustedQuantity       Decimal                @db.Decimal(12, 3)
  unitPrice              Decimal                @db.Decimal(12, 4)
  purchaseClassification PurchaseClassification @default(CMV_BEVERAGES)

  createdAt DateTime @default(now())

  receivedStockQuantity Decimal? @db.Decimal(12, 3)
  receivedUnitCost      Decimal? @db.Decimal(12, 4)
  receivedUnit          String?
  returns               PurchaseReturn[]
  inventoryLot          InventoryLot?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([purchaseClassification])
  @@map("purchase_order_items")
}

model PurchaseReturn {
  id                  String @id @default(uuid()) @db.Uuid
  establishmentId     String @db.Uuid
  requestId           String @db.Uuid
  purchaseOrderItemId  String @db.Uuid
  purchaseOrderItem    PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  stockMovementId     String @unique @db.Uuid
  stockMovement       StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  quantity            Decimal @db.Decimal(12, 3)
  purchaseQuantity    Decimal @db.Decimal(18, 9)
  unitCost            Decimal @db.Decimal(12, 4)
  totalCost           Decimal @db.Decimal(14, 4)
  returnedAt          DateTime
  createdAt           DateTime @default(now())
  recordedByUserId    String @db.Uuid
  reason              String
  financialTreatment  String @default("PENDING")
  notes               String?

  @@unique([establishmentId, requestId])
  @@index([establishmentId, returnedAt])
  @@index([purchaseOrderItemId])
  @@map("purchase_returns")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])

  productName String
  type        String

  quantity         Decimal @db.Decimal(12, 3)
  previousQuantity Decimal @db.Decimal(12, 3)
  newQuantity      Decimal @db.Decimal(12, 3)

  reference       String
  reason          String?
  createdAt       DateTime       @default(now())
  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])
  unitCost        Decimal?       @db.Decimal(12, 4)
  totalCost       Decimal?       @db.Decimal(14, 4)
  supplierId      String?        @db.Uuid
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])

  locationId String?        @db.Uuid
  location   StockLocation? @relation(fields: [locationId], references: [id])

  saleId String? @db.Uuid
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  purchaseClassification PurchaseClassification?
  responsibleSector      String?
  notes                  String?
  periodFrom             DateTime?
  periodTo               DateTime?
  recordedByUserId       String?                 @db.Uuid
  purchaseReturn        PurchaseReturn?

  @@index([establishmentId])
  @@index([productId])
  @@index([createdAt])
  @@index([saleId])
  @@index([establishmentId, purchaseClassification, createdAt])
  @@index([establishmentId, createdAt, id])
  @@map("stock_movements")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actionType  String
  entityType  String
  entityId    String
  description String

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([establishmentId])
  @@index([createdAt])
  @@map("audit_logs")
}

model establishments {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  cnpj             String?
  telefone         String?
  endereco         String?
  cidade           String?
  estado           String?
  isActive         Boolean   @default(true)
  archivedAt       DateTime?
  archivedByUserId String?   @db.Uuid
  archiveReason    String?

  users          UserEstablishment[]
  products       Product[]
  suppliers      Supplier[]
  categories     Category[]
  auditLogs      AuditLog[]
  recipes        Recipe[]
  stockAudits    StockAudit[]
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id])

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  transfersFrom        StockTransfer[]       @relation("TransferFrom")
  transfersTo          StockTransfer[]       @relation("TransferTo")
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  consumptionEvents    ConsumptionEvent[]
  productionOrders     ProductionOrder[]
  stockLocations       StockLocation[]
  portioningRecipes    PortioningRecipe[]
  portioningOrders     PortioningOrder[]
  sales                Sale[]
  eventCustomers       EventCustomer[]
  commercialEvents     CommercialEvent[]
  commercialAgreements CommercialAgreement[]
  purchaseInvoices     PurchaseInvoice[]
  bonusReceipts        BonusReceipt[]
  inventoryLots        InventoryLot[]
  tableReservations    TableReservation[]
  tableOccupancies     TableOccupancy[]
  securityAuditEvents  SecurityAuditEvent[]
  checklistRuns        ChecklistRun[]
}

model users {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  establishments              UserEstablishment[]
  stockAudits                 StockAudit[]
  purchase_orders             PurchaseOrder[]
  productionOrders            ProductionOrder[]
  portioningOrders            PortioningOrder[]
  responsibleCommercialEvents CommercialEvent[]      @relation("CommercialEventResponsible")
  eventBudgetsCreated         EventBudget[]           @relation("EventBudgetCreatedBy")
  eventBudgetsApproved        EventBudget[]           @relation("EventBudgetApprovedBy")
  tableReservationsCreated    TableReservation[]      @relation("TableReservationCreatedBy")
  tableReservationsUpdated    TableReservation[]      @relation("TableReservationUpdatedBy")
  tableReservationsCheckedIn  TableReservation[]      @relation("TableReservationCheckedInBy")
  tableOccupanciesCreated     TableOccupancy[]        @relation("TableOccupancyCreatedBy")
  tableOccupanciesReleased    TableOccupancy[]        @relation("TableOccupancyReleasedBy")
  organizationAuthorities     OrganizationAuthority[] @relation("OrganizationAuthorityUser")
  verifiedAuthorities         OrganizationAuthority[] @relation("OrganizationAuthorityVerifier")
  revokedAuthorities          OrganizationAuthority[] @relation("OrganizationAuthorityRevoker")
  securityAuditEventsAsActor  SecurityAuditEvent[]    @relation("SecurityAuditActor")
  securityAuditEventsAsTarget SecurityAuditEvent[]    @relation("SecurityAuditTarget")
}

enum TableReservationStatus {
  CONFIRMED
  CANCELLED
}

model TableReservation {
  id              String                 @id @default(uuid()) @db.Uuid
  establishmentId String                 @db.Uuid
  establishment   establishments         @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  tableNumber     Int
  reservationDate DateTime               @db.Date
  reservationTime DateTime               @db.Time(0)
  customerName    String                 @db.VarChar(160)
  phone           String?                @db.VarChar(30)
  partySize       Int
  reservationGroupId String?             @db.Uuid
  notes           String?
  status          TableReservationStatus @default(CONFIRMED)
  version         Int                    @default(1)
  createdByUserId String                 @db.Uuid
  createdByUser   users                  @relation("TableReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String                 @db.Uuid
  updatedByUser   users                  @relation("TableReservationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  checkedInAt       DateTime?
  checkedInByUserId String?                @db.Uuid
  checkedInByUser   users?                 @relation("TableReservationCheckedInBy", fields: [checkedInByUserId], references: [id], onDelete: Restrict)
  occupancy         TableOccupancy?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([establishmentId, reservationDate])
  @@index([establishmentId, reservationDate, status])
  @@index([reservationGroupId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([checkedInByUserId])
  @@map("table_reservations")
}

enum TableOccupancyStatus {
  ACTIVE
  RELEASED
}

model TableOccupancy {
  id               String               @id @default(uuid()) @db.Uuid
  establishmentId  String               @db.Uuid
  establishment    establishments       @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  tableNumber      Int
  customerName     String?              @db.VarChar(160)
  partySize        Int
  occupancyGroupId String?              @db.Uuid
  notes            String?
  status           TableOccupancyStatus @default(ACTIVE)
  version          Int                  @default(1)
  seatedAt         DateTime             @default(now())
  releasedAt       DateTime?
  createdByUserId  String               @db.Uuid
  createdByUser    users                @relation("TableOccupancyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  releasedByUserId String?              @db.Uuid
  releasedByUser   users?               @relation("TableOccupancyReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)
  reservationId    String?              @unique @db.Uuid
  reservation      TableReservation?    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([establishmentId, status])
  @@index([establishmentId, seatedAt])
  @@index([occupancyGroupId])
  @@index([createdByUserId])
  @@index([releasedByUserId])
  @@map("table_occupancies")
}

model EventCustomer {
  id              String            @id @default(uuid()) @db.Uuid
  establishmentId String            @db.Uuid
  establishment   establishments    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  name            String            @db.VarChar(160)
  document        String?           @db.VarChar(30)
  phone           String?           @db.VarChar(30)
  email           String?           @db.VarChar(254)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  events          CommercialEvent[]

  @@index([establishmentId, name])
  @@index([establishmentId, document])
  @@map("commercial_event_customers")
}

model CommercialEvent {
  id                String                @id @default(uuid()) @db.Uuid
  establishmentId   String                @db.Uuid
  establishment     establishments        @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  customerId        String                @db.Uuid
  customer          EventCustomer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  code              String                @db.VarChar(30)
  name              String                @db.VarChar(180)
  type              CommercialEventType
  eventDate         DateTime              @db.Date
  startTime         DateTime?             @db.Time(0)
  endTime           DateTime?             @db.Time(0)
  guestCount        Int
  location          String?
  responsibleUserId String?               @db.Uuid
  responsibleUser   users?                @relation("CommercialEventResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  status            CommercialEventStatus @default(DRAFT)
  internalNotes     String?
  approvedBudgetId  String?               @unique @db.Uuid
  approvedBudget    EventBudget?          @relation("CommercialEventApprovedBudget", fields: [approvedBudgetId], references: [id], onDelete: SetNull)
  budgets           EventBudget[]         @relation("CommercialEventBudgets")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([establishmentId, code])
  @@index([establishmentId, eventDate])
  @@index([establishmentId, status, eventDate])
  @@index([customerId])
  @@map("commercial_events")
}

model EventBudget {
  id                     String            @id @default(uuid()) @db.Uuid
  eventId                String            @db.Uuid
  event                  CommercialEvent   @relation("CommercialEventBudgets", fields: [eventId], references: [id], onDelete: Cascade)
  approvedForEvent       CommercialEvent?  @relation("CommercialEventApprovedBudget")
  revision               Int
  parentBudgetId         String?           @db.Uuid
  parentBudget           EventBudget?      @relation("EventBudgetRevisions", fields: [parentBudgetId], references: [id], onDelete: SetNull)
  childBudgets           EventBudget[]     @relation("EventBudgetRevisions")
  status                 EventBudgetStatus @default(DRAFT)
  validUntil             DateTime?         @db.Date
  customerSnapshot       Json?
  eventSnapshot          Json?
  guestCountSnapshot     Int
  costMenu               Decimal           @default(0) @db.Decimal(14, 4)
  costStaff              Decimal           @default(0) @db.Decimal(14, 4)
  costService            Decimal           @default(0) @db.Decimal(14, 4)
  costEquipment          Decimal           @default(0) @db.Decimal(14, 4)
  costTransport          Decimal           @default(0) @db.Decimal(14, 4)
  costFees               Decimal           @default(0) @db.Decimal(14, 4)
  costOther              Decimal           @default(0) @db.Decimal(14, 4)
  totalCost              Decimal           @default(0) @db.Decimal(14, 4)
  desiredMarginPercent   Decimal           @default(30) @db.Decimal(7, 4)
  taxPercent             Decimal           @default(0) @db.Decimal(7, 4)
  commissionPercent      Decimal           @default(0) @db.Decimal(7, 4)
  cardFeePercent         Decimal           @default(0) @db.Decimal(7, 4)
  otherFeePercent        Decimal           @default(0) @db.Decimal(7, 4)
  recommendedPrice       Decimal           @default(0) @db.Decimal(14, 4)
  quotedPrice            Decimal?          @db.Decimal(14, 4)
  expectedRevenue        Decimal?          @db.Decimal(14, 4)
  expectedFeeAmount      Decimal?          @db.Decimal(14, 4)
  expectedProfit         Decimal?          @db.Decimal(14, 4)
  effectiveMarginPercent Decimal?          @db.Decimal(7, 4)
  menuCMVPercent         Decimal?          @db.Decimal(7, 4)
  pricePerGuest          Decimal?          @db.Decimal(14, 4)
  costPerGuest           Decimal           @default(0) @db.Decimal(14, 4)
  profitPerGuest         Decimal?          @db.Decimal(14, 4)
  calculationVersion     String            @default("EVENT_PRICING_V1") @db.VarChar(40)
  customerProposalNotes  String?
  internalNotes          String?
  sentAt                 DateTime?
  approvedAt             DateTime?
  createdByUserId        String            @db.Uuid
  createdByUser          users             @relation("EventBudgetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId       String?           @db.Uuid
  approvedByUser         users?            @relation("EventBudgetApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  items                  EventBudgetItem[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([eventId, revision])
  @@index([eventId, status])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@map("event_budgets")
}

model EventBudgetItem {
  id                         String               @id @default(uuid()) @db.Uuid
  budgetId                   String               @db.Uuid
  budget                     EventBudget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  itemType                   EventBudgetItemType
  costGroup                  EventBudgetCostGroup
  sourceId                   String?              @db.Uuid
  sourceType                 String?              @db.VarChar(50)
  nameSnapshot               String               @db.VarChar(180)
  categorySnapshot           String?              @db.VarChar(100)
  quantityMode               EventQuantityMode
  fixedQuantity              Decimal?             @db.Decimal(14, 3)
  quantityPerGuest           Decimal?             @db.Decimal(14, 4)
  guestCountSnapshot         Int
  safetyPercent              Decimal              @default(0) @db.Decimal(7, 4)
  plannedQuantity            Decimal              @db.Decimal(14, 3)
  unitSnapshot               String               @db.VarChar(30)
  unitCostSnapshot           Decimal              @db.Decimal(14, 4)
  totalCost                  Decimal              @db.Decimal(14, 4)
  suggestedUnitPriceSnapshot Decimal?             @db.Decimal(14, 4)
  visibleInProposal          Boolean              @default(true)
  proposalLabel              String?              @db.VarChar(180)
  internalNotes              String?
  compositionSnapshot        Json?
  sourceSnapshot             Json?
  sortOrder                  Int                  @default(0)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime              @updatedAt

  @@index([budgetId, sortOrder])
  @@index([sourceId])
  @@map("event_budget_items")
}

model Sale {
  id              String          @id @default(uuid()) @db.Uuid
  establishmentId String          @db.Uuid
  establishment   establishments  @relation(fields: [establishmentId], references: [id])
  source          String
  status          String          @default("COMPLETED")
  externalId      String?
  grossTotal      Decimal?        @db.Decimal(14, 2)
  discountTotal   Decimal?        @db.Decimal(14, 2)
  netTotal        Decimal?        @db.Decimal(14, 2)
  costTotal       Decimal         @default(0) @db.Decimal(14, 4)
  soldAt          DateTime        @default(now())
  createdAt       DateTime        @default(now())
  items           SaleItem[]
  stockMovements  StockMovement[]

  @@unique([establishmentId, source, externalId])
  @@index([establishmentId, soldAt])
  @@index([establishmentId, status, soldAt])
  @@map("sales")
}

model SaleItem {
  id            String   @id @default(uuid()) @db.Uuid
  saleId        String   @db.Uuid
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String?  @db.Uuid
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  quantity      Decimal  @db.Decimal(12, 3)
  unitSalePrice Decimal? @db.Decimal(12, 4)
  grossTotal    Decimal? @db.Decimal(14, 2)
  discountTotal Decimal? @db.Decimal(14, 2)
  netTotal      Decimal? @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum CommercialAgreementStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BonusReceiptStatus {
  RECEIVED
  CANCELLED
}

model CommercialAgreement {
  id                 String                       @id @default(uuid()) @db.Uuid
  establishmentId    String                       @db.Uuid
  establishment      establishments               @relation(fields: [establishmentId], references: [id])
  supplierId         String                       @db.Uuid
  supplier           Supplier                     @relation(fields: [supplierId], references: [id])
  name               String
  brand              String?
  buyQuantity        Decimal                      @db.Decimal(12, 3)
  bonusQuantity      Decimal                      @db.Decimal(12, 3)
  currentRemainder   Decimal                      @default(0) @db.Decimal(12, 3)
  allowMixedProducts Boolean                      @default(true)
  startsAt           DateTime
  endsAt             DateTime?
  status             CommercialAgreementStatus    @default(ACTIVE)
  notes              String?
  createdByUserId    String                       @db.Uuid
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  products           CommercialAgreementProduct[]
  accruals           BonusAccrual[]
  receipts           BonusReceipt[]

  @@index([establishmentId, status])
  @@index([supplierId, status])
  @@map("commercial_agreements")
}

model CommercialAgreementProduct {
  id                   String              @id @default(uuid()) @db.Uuid
  agreementId          String              @db.Uuid
  agreement            CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  productId            String              @db.Uuid
  product              Product             @relation(fields: [productId], references: [id])
  eligibilityFactor    Decimal             @default(1) @db.Decimal(12, 4)
  canGenerateBonus     Boolean             @default(true)
  canBeReceivedAsBonus Boolean             @default(true)

  @@unique([agreementId, productId])
  @@index([productId])
  @@map("commercial_agreement_products")
}

model PurchaseInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  establishmentId String                @db.Uuid
  establishment   establishments        @relation(fields: [establishmentId], references: [id])
  supplierId      String                @db.Uuid
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrderId String                @unique @db.Uuid
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  invoiceNumber   String
  invoiceSeries   String                @default("")
  issuedAt        DateTime
  receivedAt      DateTime              @default(now())
  netPaidAmount   Decimal?              @db.Decimal(14, 2)
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())
  items           PurchaseInvoiceItem[]
  accruals        BonusAccrual[]

  @@unique([establishmentId, supplierId, invoiceNumber, invoiceSeries])
  @@index([establishmentId, issuedAt])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id        String          @id @default(uuid()) @db.Uuid
  invoiceId String          @db.Uuid
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Decimal         @db.Decimal(12, 3)
  unitPrice Decimal         @db.Decimal(12, 4)
  createdAt DateTime        @default(now())

  @@index([invoiceId])
  @@index([productId])
  @@map("purchase_invoice_items")
}

model BonusAccrual {
  id                  String              @id @default(uuid()) @db.Uuid
  agreementId         String              @db.Uuid
  agreement           CommercialAgreement @relation(fields: [agreementId], references: [id])
  invoiceId           String              @db.Uuid
  invoice             PurchaseInvoice     @relation(fields: [invoiceId], references: [id])
  eligibleQuantity    Decimal             @db.Decimal(12, 3)
  balanceBefore       Decimal             @db.Decimal(12, 3)
  earnedBonusQuantity Decimal             @db.Decimal(12, 3)
  balanceAfter        Decimal             @db.Decimal(12, 3)
  createdAt           DateTime            @default(now())

  @@unique([agreementId, invoiceId])
  @@index([agreementId, createdAt])
  @@map("bonus_accruals")
}

model BonusReceipt {
  id                String              @id @default(uuid()) @db.Uuid
  establishmentId   String              @db.Uuid
  establishment     establishments      @relation(fields: [establishmentId], references: [id])
  supplierId        String              @db.Uuid
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  agreementId       String              @db.Uuid
  agreement         CommercialAgreement @relation(fields: [agreementId], references: [id])
  invoiceNumber     String
  invoiceSeries     String              @default("")
  invoiceDate       DateTime
  additionalCredits Decimal             @default(0) @db.Decimal(14, 2)
  status            BonusReceiptStatus  @default(RECEIVED)
  createdByUserId   String              @db.Uuid
  createdAt         DateTime            @default(now())
  items             BonusReceiptItem[]

  @@unique([establishmentId, supplierId, invoiceNumber, invoiceSeries])
  @@index([agreementId, invoiceDate])
  @@map("bonus_receipts")
}

model BonusReceiptItem {
  id                       String       @id @default(uuid()) @db.Uuid
  bonusReceiptId           String       @db.Uuid
  bonusReceipt             BonusReceipt @relation(fields: [bonusReceiptId], references: [id], onDelete: Cascade)
  productId                String       @db.Uuid
  product                  Product      @relation(fields: [productId], references: [id])
  locationId               String       @db.Uuid
  quantity                 Decimal      @db.Decimal(12, 3)
  fiscalUnitPrice          Decimal      @db.Decimal(12, 4)
  commercialReferencePrice Decimal      @db.Decimal(12, 4)
  fiscalTotal              Decimal      @db.Decimal(14, 2)
  commercialBenefit        Decimal      @db.Decimal(14, 2)
  createdAt                DateTime     @default(now())

  @@index([bonusReceiptId])
  @@index([productId])
  @@map("bonus_receipt_items")
}

model ProductSupplier {
  id String @id @default(uuid()) @db.Uuid

  productId  String @db.Uuid
  supplierId String @db.Uuid

  price Decimal @default(0) @db.Decimal(12, 4)

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model SupplierPriceHistory {
  id String @id @default(uuid()) @db.Uuid

  productId  String @db.Uuid
  supplierId String @db.Uuid

  price Decimal @db.Decimal(12, 4)

  purchaseOrderId String? @db.Uuid

  createdAt DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@map("supplier_price_history")
}

model Recipe {
  id String @id @default(uuid()) @db.Uuid

  productId String  @unique @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  items RecipeItem[]

  yieldQuantity Decimal @default(1) @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@map("recipes")
}

model RecipeItem {
  id String @id @default(uuid()) @db.Uuid

  recipeId String @db.Uuid
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@unique([recipeId, productId])
  @@map("recipe_items")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  establishments      establishments[]
  products            OrganizationProduct[]
  productCodeSequence OrganizationProductSequence?
  productReviews      OrganizationProductReview[]
  suppliers           OrganizationSupplier[]
  supplierReviews     OrganizationSupplierReview[]
  subscription        OrganizationSubscription?
  authorities         OrganizationAuthority[]
  securityAuditEvents SecurityAuditEvent[]
  checklistTemplates  ChecklistTemplate[]
  checklistRuns       ChecklistRun[]
}

model OrganizationSupplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String
  name           String
  legalName      String?
  cnpj           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id])
  localSuppliers Supplier[]
  catalogItems   SupplierCatalogItem[]
  priceUpdates   SupplierPriceUpdate[]
  portalUsers    SupplierPortalUser[]

  @@index([organizationId])
  @@index([organizationId, cnpj])
  @@map("organization_suppliers")
}

model SupplierPortalUser {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationSupplierId String    @db.Uuid
  name                   String
  email                  String    @unique
  passwordHash           String
  isActive               Boolean   @default(true)
  isBlocked              Boolean   @default(false)
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  revokedAt              DateTime?
  sessionVersion         Int       @default(1)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organizationSupplier OrganizationSupplier @relation(fields: [organizationSupplierId], references: [id])

  @@index([organizationSupplierId, isActive])
  @@map("supplier_portal_users")
}

model OrganizationSupplierReview {
  id                            String    @id @default(uuid()) @db.Uuid
  organizationId                String
  candidateKey                  String
  status                        String
  supplierIds                   Json
  suggestedName                 String
  normalizedCnpj                String
  appliedOrganizationSupplierId String?   @db.Uuid
  reviewedByUserId              String?   @db.Uuid
  reviewedAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, candidateKey])
  @@index([organizationId, status])
  @@map("organization_supplier_reviews")
}

model OrganizationProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String
  internalCode   String
  name           String
  brand          String?
  baseUnit       String
  barcode        String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  localProducts        Product[]
  supplierCatalogItems SupplierCatalogItem[]

  @@unique([organizationId, internalCode])
  @@index([organizationId, barcode])
  @@map("organization_products")
}

model SupplierCatalogItem {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationSupplierId String    @db.Uuid
  organizationProductId  String    @db.Uuid
  supplierCode           String?
  commercialUnit         String
  unitsPerPackage        Decimal   @db.Decimal(12, 3)
  packagePrice           Decimal   @db.Decimal(12, 4)
  normalizedUnitPrice    Decimal   @db.Decimal(12, 4)
  available              Boolean   @default(true)
  minimumOrder           Decimal?  @db.Decimal(12, 3)
  deliveryLeadDays       Int?
  validUntil             DateTime?
  status                 String    @default("ACTIVE")
  lastSubmittedAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organizationSupplier OrganizationSupplier      @relation(fields: [organizationSupplierId], references: [id])
  organizationProduct  OrganizationProduct       @relation(fields: [organizationProductId], references: [id])
  updateItems          SupplierPriceUpdateItem[]

  @@unique([organizationSupplierId, organizationProductId])
  @@index([organizationProductId])
  @@map("supplier_catalog_items")
}

model SupplierPriceUpdate {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationSupplierId String    @db.Uuid
  status                 String    @default("DRAFT")
  note                   String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  appliedAt              DateTime?
  approvedByUserId       String?   @db.Uuid
  createdByUserId        String?   @db.Uuid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organizationSupplier OrganizationSupplier      @relation(fields: [organizationSupplierId], references: [id])
  items                SupplierPriceUpdateItem[]

  @@index([organizationSupplierId, status])
  @@index([createdAt, id])
  @@map("supplier_price_updates")
}

model SupplierPriceUpdateItem {
  id                      String   @id @default(uuid()) @db.Uuid
  supplierPriceUpdateId   String   @db.Uuid
  supplierCatalogItemId   String   @db.Uuid
  previousPackagePrice    Decimal  @db.Decimal(12, 4)
  newPackagePrice         Decimal  @db.Decimal(12, 4)
  previousNormalizedPrice Decimal  @db.Decimal(12, 4)
  newNormalizedPrice      Decimal  @db.Decimal(12, 4)
  commercialUnit          String
  unitsPerPackage         Decimal  @db.Decimal(12, 3)
  available               Boolean
  deliveryLeadDays        Int?
  status                  String   @default("PENDING")
  rejectionReason         String?
  affectedEstablishments  Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  update      SupplierPriceUpdate @relation(fields: [supplierPriceUpdateId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem @relation(fields: [supplierCatalogItemId], references: [id])

  @@unique([supplierPriceUpdateId, supplierCatalogItemId])
  @@index([supplierCatalogItemId])
  @@map("supplier_price_update_items")
}

model OrganizationProductSequence {
  organizationId String @id
  currentValue   Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_product_sequences")
}

model OrganizationProductReview {
  id                           String    @id @default(uuid()) @db.Uuid
  organizationId               String
  candidateKey                 String
  status                       String
  productIds                   Json
  suggestedName                String
  appliedOrganizationProductId String?   @db.Uuid
  reviewedByUserId             String?   @db.Uuid
  reviewedAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, candidateKey])
  @@index([organizationId, status])
  @@map("organization_product_reviews")
}

model StockTransfer {
  id String @id @default(uuid()) @db.Uuid

  productId            String  @db.Uuid
  destinationProductId String? @db.Uuid
  quantity             Float
  destinationQuantity  Float?
  sourceUnit            String?
  destinationUnit       String?
  sourcePackQuantity    Float?
  destinationPackQuantity Float?
  conversionFactor      Float?

  fromEstablishmentId String @db.Uuid
  toEstablishmentId   String @db.Uuid

  status TransferStatus @default(PENDING)

  createdBy  String  @db.Uuid
  approvedBy String? @db.Uuid

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  product            Product  @relation("TransferSourceProduct", fields: [productId], references: [id])
  destinationProduct Product? @relation("TransferDestinationProduct", fields: [destinationProductId], references: [id])

  fromEstablishment establishments @relation("TransferFrom", fields: [fromEstablishmentId], references: [id])
  toEstablishment   establishments @relation("TransferTo", fields: [toEstablishmentId], references: [id])
}

model UserEstablishment {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @db.Uuid
  establishmentId String @db.Uuid

  role      String // ex: ADMIN, MANAGER, STAFF
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user          users          @relation(fields: [userId], references: [id])
  establishment establishments @relation(fields: [establishmentId], references: [id])
  access                      UserEstablishmentAccess?
  accessConfigurationsCreated   AccessConfiguration[] @relation("AccessConfigurationCreatedBy")
  accessConfigurationsActivated AccessConfiguration[] @relation("AccessConfigurationActivatedBy")
  securityAuditEventsAsActor    SecurityAuditEvent[]   @relation("SecurityAuditActorMembership")
  securityAuditEventsAsTarget   SecurityAuditEvent[]   @relation("SecurityAuditTargetMembership")
  checklistTemplatesCreated     ChecklistTemplate[]        @relation("ChecklistTemplateCreatedBy")
  checklistVersionsCreated      ChecklistTemplateVersion[] @relation("ChecklistTemplateVersionCreatedBy")
  checklistVersionsPublished    ChecklistTemplateVersion[] @relation("ChecklistTemplateVersionPublishedBy")
  checklistRunsAssigned         ChecklistRun[]              @relation("ChecklistRunAssignedTo")
  checklistRunsCreated          ChecklistRun[]              @relation("ChecklistRunCreatedBy")
  checklistAssignmentsPrevious  ChecklistRunAssignment[]    @relation("ChecklistAssignmentPrevious")
  checklistAssignmentsAssigned  ChecklistRunAssignment[]    @relation("ChecklistAssignmentAssigned")
  checklistAssignmentsChanged   ChecklistRunAssignment[]    @relation("ChecklistAssignmentChangedBy")
  checklistRunEvents            ChecklistRunEvent[]         @relation("ChecklistRunEventActor")
  checklistAttemptsExecuted     ChecklistExecutionAttempt[] @relation("ChecklistAttemptExecutor")
  checklistResponsesAnswered    ChecklistResponse[]         @relation("ChecklistResponseAnsweredBy")
  checklistEvidencesUploaded    ChecklistEvidence[]         @relation("ChecklistEvidenceUploadedBy")
  checklistApprovalsDecided     ChecklistApproval[]         @relation("ChecklistApprovalApprover")

  @@unique([userId, establishmentId])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

model StockAudit {
  id String @id @default(uuid()) @db.Uuid

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdBy String @db.Uuid
  user      users  @relation(fields: [createdBy], references: [id])

  status String @default("OPEN")

  createdAt DateTime  @default(now())
  countedAt DateTime?

  items StockAuditItem[]

  @@index([establishmentId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("stock_audits")
}

model StockAuditItem {
  id String @id @default(uuid()) @db.Uuid

  auditId String     @db.Uuid
  audit   StockAudit @relation(fields: [auditId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  systemQuantity Decimal @db.Decimal(12, 3)

  countedQuantity Decimal @default(0) @db.Decimal(12, 3)

  difference Decimal @default(0) @db.Decimal(12, 3)

  locationId String?        @db.Uuid
  location   StockLocation? @relation(fields: [locationId], references: [id])

  @@map("stock_audit_items")
}

model ConsumptionEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String
  status          String                 @default("OPEN") // OPEN, CLOSED
  establishmentId String                 @db.Uuid
  establishment   establishments         @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime               @default(now())
  completedAt     DateTime?
  items           ConsumptionEventItem[]

  @@index([establishmentId])
  @@map("consumption_events")
}

model ConsumptionEventItem {
  id           String           @id @default(uuid()) @db.Uuid
  eventId      String           @db.Uuid
  event        ConsumptionEvent @relation(fields: [eventId], references: [id])
  productId    String           @db.Uuid
  product      Product          @relation(fields: [productId], references: [id])
  withdrawnQty Decimal          @db.Decimal(12, 3) // em unidades base (ml/g)
  returnedQty  Decimal          @default(0) @db.Decimal(12, 3) // em unidades base (ml/g)
  unitCost     Decimal          @db.Decimal(12, 4) // custo unitário no momento da retirada

  createdAt DateTime @default(now())

  locationId String?        @db.Uuid
  location   StockLocation? @relation(fields: [locationId], references: [id])

  @@index([eventId])
  @@index([productId])
  @@map("consumption_event_items")
}

////////////////////////////////////////////////////////////
//////////////////// PRODUCTION ////////////////////////////
////////////////////////////////////////////////////////////

enum ProductionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  status ProductionStatus @default(PENDING)

  notes String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdBy String @db.Uuid
  user      users  @relation(fields: [createdBy], references: [id])

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([establishmentId])
  @@index([createdAt])
  @@index([status])
  @@map("production_orders")
}

model StockLocation {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  isDefault       Boolean        @default(false)
  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime       @default(now())

  productStocks    ProductStock[]
  stockMovements   StockMovement[]
  auditItems       StockAuditItem[]
  consumptionItems ConsumptionEventItem[]
  products         Product[]              @relation("ProductDefaultLocation")

  @@unique([name, establishmentId])
  @@map("stock_locations")
}

model ProductStock {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  locationId String  @db.Uuid
  quantity   Decimal @default(0) @db.Decimal(12, 3)

  product  Product       @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
  @@map("product_stocks")
}

////////////////////////////////////////////////////////////
//////////////////// PORTIONING / DESOSSA //////////////////
////////////////////////////////////////////////////////////

model PortioningRecipe {
  id String @id @default(uuid()) @db.Uuid

  sourceProductId String  @unique @db.Uuid
  sourceProduct   Product @relation("PortioningSourceProduct", fields: [sourceProductId], references: [id])

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  items PortioningRecipeItem[]

  createdAt DateTime @default(now())

  @@map("portioning_recipes")
}

model PortioningRecipeItem {
  id String @id @default(uuid()) @db.Uuid

  portioningRecipeId String           @db.Uuid
  portioningRecipe   PortioningRecipe @relation(fields: [portioningRecipeId], references: [id], onDelete: Cascade)

  targetProductId String  @db.Uuid
  targetProduct   Product @relation("PortioningTargetProduct", fields: [targetProductId], references: [id])

  costAllocationPercentage Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@unique([portioningRecipeId, targetProductId])
  @@map("portioning_recipe_items")
}

model PortioningOrder {
  id String @id @default(uuid()) @db.Uuid

  sourceProductId String  @db.Uuid
  sourceProduct   Product @relation("PortioningOrderSourceProduct", fields: [sourceProductId], references: [id])

  sourceQuantity Decimal @db.Decimal(12, 3)

  sourceLotId String?       @db.Uuid
  sourceLot   InventoryLot? @relation(fields: [sourceLotId], references: [id], onDelete: Restrict)

  status ProductionStatus @default(PENDING)

  notes String?

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id])

  createdBy String @db.Uuid
  user      users  @relation(fields: [createdBy], references: [id])

  items PortioningOrderItem[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([establishmentId])
  @@index([createdAt])
  @@index([status])
  @@index([sourceLotId])
  @@map("portioning_orders")
}

model PortioningOrderItem {
  id String @id @default(uuid()) @db.Uuid

  portioningOrderId String          @db.Uuid
  portioningOrder   PortioningOrder @relation(fields: [portioningOrderId], references: [id], onDelete: Cascade)

  targetProductId String  @db.Uuid
  targetProduct   Product @relation("PortioningOrderTargetProduct", fields: [targetProductId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  netWeightKg Decimal? @db.Decimal(12, 3)

  costAllocationPercentage Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@map("portioning_order_items")
}

model InventoryLot {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  establishmentId String         @db.Uuid
  establishment   establishments @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  supplierId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  purchaseOrderItemId String            @unique @db.Uuid
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  initialQuantity   Decimal  @db.Decimal(12, 3)
  remainingQuantity Decimal  @db.Decimal(12, 3)
  unit              String
  receivedAt        DateTime
  createdAt         DateTime @default(now())

  portioningOrders PortioningOrder[]

  @@index([establishmentId, productId, receivedAt])
  @@index([establishmentId, remainingQuantity])
  @@map("inventory_lots")
}

model OrganizationSubscription {
  id                                String                         @id @default(uuid()) @db.Uuid
  organizationId                    String                         @unique
  organization                      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planCode                          String                         @default("COMMERCIAL_MONTHLY")
  status                            OrganizationSubscriptionStatus @default(PENDING)
  currency                          String                         @default("BRL") @db.VarChar(3)
  includedEstablishments            Int                            @default(1)
  basePriceCents                    Int                            @default(14900)
  additionalEstablishmentPriceCents Int                            @default(12000)
  externalCustomerId                String?                        @unique
  externalSubscriptionId            String?                        @unique
  quantitySyncPending               Boolean                        @default(false)
  currentPeriodStartsAt             DateTime?
  currentPeriodEndsAt               DateTime?
  canceledAt                        DateTime?
  createdAt                         DateTime                       @default(now())
  updatedAt                         DateTime                       @updatedAt

  @@index([status])
  @@map("organization_subscriptions")
}

model BillingWebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([processedAt])
  @@map("billing_webhook_events")
}

model UserEstablishmentAccess {
  id                  String            @id @default(uuid()) @db.Uuid
  userEstablishmentId String            @unique @db.Uuid
  mode                AuthorizationMode @default(LEGACY)
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  userEstablishment UserEstablishment    @relation(fields: [userEstablishmentId], references: [id], onDelete: Restrict)
  configurations    AccessConfiguration[]

  @@index([mode])
  @@map("user_establishment_accesses")
}

model AccessConfiguration {
  id                      String                    @id @default(uuid()) @db.Uuid
  accessId                String                    @db.Uuid
  profileCode             AccessProfileCode
  profileVersion          Int
  status                  AccessConfigurationStatus @default(DRAFT)
  basedOnLegacyRole       String
  previousConfigurationId String?                   @db.Uuid
  createdByMembershipId   String                    @db.Uuid
  activatedByMembershipId String?                   @db.Uuid
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  activatedAt             DateTime?
  retiredAt               DateTime?

  access                UserEstablishmentAccess @relation(fields: [accessId], references: [id], onDelete: Restrict)
  previousConfiguration AccessConfiguration?    @relation("AccessConfigurationHistory", fields: [previousConfigurationId], references: [id], onDelete: Restrict)
  nextConfigurations    AccessConfiguration[]   @relation("AccessConfigurationHistory")
  createdByMembership   UserEstablishment       @relation("AccessConfigurationCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  activatedByMembership UserEstablishment?      @relation("AccessConfigurationActivatedBy", fields: [activatedByMembershipId], references: [id], onDelete: Restrict)
  overrides             PermissionOverride[]

  @@index([accessId, status])
  @@index([createdByMembershipId, createdAt])
  @@map("access_configurations")
}

model PermissionOverride {
  id              String           @id @default(uuid()) @db.Uuid
  configurationId String           @db.Uuid
  permissionCode  String
  effect          PermissionEffect
  reason          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  configuration AccessConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, permissionCode])
  @@index([permissionCode, effect])
  @@map("permission_overrides")
}

model OrganizationAuthority {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String
  userId             String                    @db.Uuid
  type               OrganizationAuthorityType @default(OWNER)
  isActive           Boolean                   @default(true)
  verifiedAt         DateTime
  verifiedByUserId   String?                   @db.Uuid
  verificationMethod String
  revokedAt          DateTime?
  revokedByUserId    String?                   @db.Uuid
  revocationReason   String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         users        @relation("OrganizationAuthorityUser", fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy   users?       @relation("OrganizationAuthorityVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  revokedBy    users?       @relation("OrganizationAuthorityRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, type])
  @@index([organizationId, type, isActive])
  @@map("organization_authorities")
}

model SecurityAuditEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String
  establishmentId    String?  @db.Uuid
  actorUserId        String   @db.Uuid
  actorMembershipId  String?  @db.Uuid
  targetUserId       String?  @db.Uuid
  targetMembershipId String?  @db.Uuid
  eventType          String
  entityType         String
  entityId           String
  beforeJson         Json?
  afterJson          Json?
  metadataJson       Json?
  occurredAt         DateTime @default(now())

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  establishment    establishments?    @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  actorUser        users              @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership  UserEstablishment? @relation("SecurityAuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: Restrict)
  targetUser       users?             @relation("SecurityAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetMembership UserEstablishment? @relation("SecurityAuditTargetMembership", fields: [targetMembershipId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([establishmentId, occurredAt])
  @@index([targetMembershipId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("security_audit_events")
}

enum ChecklistTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum ChecklistTemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ChecklistResponseType {
  BOOLEAN
  CHOICE
  NUMBER
  TEXT
}

enum ChecklistRunStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ChecklistAssignmentType {
  INITIAL
  REASSIGNMENT
}

enum ChecklistRunEventType {
  RUN_CREATED
  ASSIGNMENT_CHANGED
  ATTEMPT_STARTED
  RESPONSE_SAVED
  EVIDENCE_ADDED
  ATTEMPT_SUBMITTED
  ATTEMPT_APPROVED
  ATTEMPT_REJECTED
  ATTEMPT_AUTO_APPROVED
}

enum ChecklistAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum ChecklistResponseOutcome {
  PASS
  FAIL
  NOT_APPLICABLE
  UNASSESSED
}

enum ChecklistEvidenceStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  DELETED
}

enum ChecklistApprovalDecision {
  APPROVE
  REJECT
}

model ChecklistTemplate {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String
  code                  String                  @db.VarChar(80)
  name                  String                  @db.VarChar(160)
  category              String?                 @db.VarChar(80)
  description           String?                 @db.VarChar(500)
  status                ChecklistTemplateStatus @default(ACTIVE)
  createdByMembershipId String                  @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    UserEstablishment   @relation("ChecklistTemplateCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  versions     ChecklistTemplateVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@index([createdByMembershipId, createdAt])
  @@map("checklist_templates")
}

model ChecklistTemplateVersion {
  id                      String                         @id @default(uuid()) @db.Uuid
  templateId              String                         @db.Uuid
  version                 Int
  status                  ChecklistTemplateVersionStatus @default(DRAFT)
  approvalRequired        Boolean                        @default(true)
  passingScore            Decimal                        @default(100) @db.Decimal(5, 2)
  scoringAlgorithmVersion Int                            @default(1)
  sourceVersionId         String?                        @db.Uuid
  createdByMembershipId   String                         @db.Uuid
  publishedByMembershipId String?                        @db.Uuid
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  publishedAt             DateTime?
  retiredAt               DateTime?

  template      ChecklistTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sourceVersion ChecklistTemplateVersion?  @relation("ChecklistTemplateVersionSource", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  derivedVersions ChecklistTemplateVersion[] @relation("ChecklistTemplateVersionSource")
  createdBy     UserEstablishment          @relation("ChecklistTemplateVersionCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  publishedBy   UserEstablishment?         @relation("ChecklistTemplateVersionPublishedBy", fields: [publishedByMembershipId], references: [id], onDelete: Restrict)
  sections      ChecklistTemplateSection[]
  runs          ChecklistRun[]

  @@unique([templateId, version])
  @@index([templateId, status, createdAt])
  @@index([createdByMembershipId, createdAt])
  @@map("checklist_template_versions")
}

model ChecklistTemplateSection {
  id                String   @id @default(uuid()) @db.Uuid
  templateVersionId String   @db.Uuid
  stableKey         String   @db.VarChar(80)
  title             String   @db.VarChar(200)
  description       String?  @db.VarChar(500)
  position          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  templateVersion ChecklistTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  items           ChecklistTemplateItem[]

  @@unique([templateVersionId, stableKey])
  @@unique([templateVersionId, position])
  @@unique([id, templateVersionId])
  @@map("checklist_template_sections")
}

model ChecklistTemplateItem {
  id                     String                @id @default(uuid()) @db.Uuid
  templateVersionId      String                @db.Uuid
  sectionId              String                @db.Uuid
  stableKey              String                @db.VarChar(80)
  title                  String                @db.VarChar(200)
  instructions           String?               @db.Text
  position               Int
  responseType           ChecklistResponseType
  required               Boolean               @default(true)
  allowNotApplicable     Boolean               @default(false)
  critical               Boolean               @default(false)
  evidenceRequired       Boolean               @default(false)
  maxPoints              Decimal               @default(1) @db.Decimal(10, 2)
  answerConfigJson       Json?
  scoringConfigJson      Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  section ChecklistTemplateSection @relation(fields: [sectionId, templateVersionId], references: [id, templateVersionId], onDelete: Restrict)
  responses ChecklistResponse[]

  @@unique([templateVersionId, stableKey])
  @@unique([sectionId, position])
  @@index([templateVersionId, position])
  @@map("checklist_template_items")
}

model ChecklistRun {
  id                    String             @id @default(uuid()) @db.Uuid
  clientRequestId       String             @db.Uuid
  requestFingerprint    String             @db.VarChar(64)
  organizationId        String
  establishmentId       String             @db.Uuid
  templateVersionId     String             @db.Uuid
  assignedMembershipId  String             @db.Uuid
  createdByMembershipId String             @db.Uuid
  dueAt                 DateTime
  status                ChecklistRunStatus @default(ASSIGNED)
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  completedAt           DateTime?

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  establishment   establishments           @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  templateVersion ChecklistTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  assignedTo      UserEstablishment        @relation("ChecklistRunAssignedTo", fields: [assignedMembershipId], references: [id], onDelete: Restrict)
  createdBy       UserEstablishment        @relation("ChecklistRunCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  assignments     ChecklistRunAssignment[]
  events          ChecklistRunEvent[]
  attempts        ChecklistExecutionAttempt[]

  @@unique([organizationId, clientRequestId])
  @@index([establishmentId, status, dueAt])
  @@index([establishmentId, dueAt])
  @@index([assignedMembershipId, status, dueAt])
  @@index([templateVersionId, createdAt])
  @@map("checklist_runs")
}

model ChecklistRunAssignment {
  id                    String                  @id @default(uuid()) @db.Uuid
  runId                 String                  @db.Uuid
  sequence              Int
  previousMembershipId  String?                 @db.Uuid
  assignedMembershipId  String                  @db.Uuid
  changedByMembershipId String                  @db.Uuid
  changeType            ChecklistAssignmentType
  reason                String?                 @db.VarChar(500)
  createdAt             DateTime                @default(now())

  run        ChecklistRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  previous   UserEstablishment? @relation("ChecklistAssignmentPrevious", fields: [previousMembershipId], references: [id], onDelete: Restrict)
  assignedTo UserEstablishment  @relation("ChecklistAssignmentAssigned", fields: [assignedMembershipId], references: [id], onDelete: Restrict)
  changedBy  UserEstablishment  @relation("ChecklistAssignmentChangedBy", fields: [changedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([runId, sequence])
  @@index([assignedMembershipId, createdAt])
  @@index([changedByMembershipId, createdAt])
  @@map("checklist_run_assignments")
}

model ChecklistRunEvent {
  id                String                    @id @default(uuid()) @db.Uuid
  runId             String                    @db.Uuid
  sequence          Int
  eventType         ChecklistRunEventType
  actorMembershipId String?                   @db.Uuid
  metadataJson      Json?
  occurredAt        DateTime                  @default(now())

  run   ChecklistRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  actor UserEstablishment? @relation("ChecklistRunEventActor", fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@unique([runId, sequence])
  @@index([eventType, occurredAt])
  @@map("checklist_run_events")
}

model ChecklistExecutionAttempt {
  id                   String                 @id @default(uuid()) @db.Uuid
  runId                String                 @db.Uuid
  attemptNumber        Int
  executorMembershipId String                 @db.Uuid
  status               ChecklistAttemptStatus @default(IN_PROGRESS)
  score                Decimal?               @db.Decimal(5, 2)
  earnedPoints         Decimal?               @db.Decimal(12, 2)
  applicablePoints     Decimal?               @db.Decimal(12, 2)
  isCompliant          Boolean?
  criticalFailure      Boolean?
  version              Int                    @default(1)
  startedAt            DateTime               @default(now())
  submittedAt          DateTime?
  decidedAt            DateTime?

  run       ChecklistRun              @relation(fields: [runId], references: [id], onDelete: Restrict)
  executor  UserEstablishment         @relation("ChecklistAttemptExecutor", fields: [executorMembershipId], references: [id], onDelete: Restrict)
  responses ChecklistResponse[]
  approvals ChecklistApproval[]

  @@unique([runId, attemptNumber])
  @@index([executorMembershipId, status, startedAt])
  @@index([submittedAt, status])
  @@map("checklist_execution_attempts")
}

model ChecklistResponse {
  id                       String                   @id @default(uuid()) @db.Uuid
  attemptId                String                   @db.Uuid
  templateItemId           String                   @db.Uuid
  valueJson                Json?
  outcome                  ChecklistResponseOutcome @default(UNASSESSED)
  note                     String?                  @db.VarChar(1000)
  earnedPoints             Decimal?                 @db.Decimal(12, 2)
  maxPointsSnapshot        Decimal                  @db.Decimal(12, 2)
  answeredByMembershipId   String                   @db.Uuid
  answeredAt               DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  version                  Int                      @default(1)

  attempt   ChecklistExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  item      ChecklistTemplateItem     @relation(fields: [templateItemId], references: [id], onDelete: Restrict)
  answeredBy UserEstablishment        @relation("ChecklistResponseAnsweredBy", fields: [answeredByMembershipId], references: [id], onDelete: Restrict)
  evidences ChecklistEvidence[]

  @@unique([attemptId, templateItemId])
  @@index([templateItemId, outcome])
  @@map("checklist_responses")
}

model ChecklistEvidence {
  id                     String                  @id @default(uuid()) @db.Uuid
  responseId             String                  @db.Uuid
  storageProvider        String                  @db.VarChar(40)
  objectKey              String                  @unique @db.VarChar(255)
  sha256                 String                  @db.VarChar(64)
  contentType            String                  @db.VarChar(80)
  byteSize               Int
  width                  Int?
  height                 Int?
  capturedAt             DateTime?
  uploadedAt             DateTime                @default(now())
  uploadedByMembershipId String                  @db.Uuid
  status                 ChecklistEvidenceStatus @default(PENDING)

  response   ChecklistResponse @relation(fields: [responseId], references: [id], onDelete: Restrict)
  uploadedBy UserEstablishment @relation("ChecklistEvidenceUploadedBy", fields: [uploadedByMembershipId], references: [id], onDelete: Restrict)

  @@index([responseId, status, uploadedAt])
  @@index([uploadedByMembershipId, uploadedAt])
  @@map("checklist_evidences")
}

model ChecklistApproval {
  id                   String                      @id @default(uuid()) @db.Uuid
  attemptId            String                      @db.Uuid
  decision             ChecklistApprovalDecision
  reason               String?                     @db.VarChar(1000)
  approverMembershipId String                      @db.Uuid
  createdAt            DateTime                    @default(now())

  attempt  ChecklistExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  approver UserEstablishment         @relation("ChecklistApprovalApprover", fields: [approverMembershipId], references: [id], onDelete: Restrict)

  @@unique([attemptId])
  @@index([approverMembershipId, createdAt])
  @@map("checklist_approvals")
}
