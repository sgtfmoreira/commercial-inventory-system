{
    "name": "controle-de-compras-bds-backend",
    "version": "1.0.0",
    "description": "Internal Inventory Management System — REST API",
    "main": "src/server.js",
    "scripts": {
        "dev": "nodemon src/server.js",
        "postinstall": "prisma generate",
        "build": "npx prisma generate && npx prisma migrate deploy && npx prisma db seed",
        "start": "node src/server.js",
        "test": "node --test test/*.test.js",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate",
        "catalog:inventory": "node scripts/inventory-organization-products.js",
        "backup:logical": "node scripts/backup-logical-snapshot.js",
        "backup:validate": "node scripts/validate-logical-snapshot.js",
        "catalog:verify-migration": "node scripts/verify-organization-products-migration.js",
        "suppliers:verify-migration": "node scripts/verify-organization-suppliers-migration.js",
        "suppliers:inventory": "node scripts/inventory-organization-suppliers.js",
        "suppliers:consolidate": "node scripts/consolidate-organization-suppliers.js",
        "prices:verify-migration": "node scripts/verify-supplier-price-updates-migration.js",
        "portal:smoke": "node scripts/smoke-supplier-portal.js",
        "events:readiness": "node scripts/check-events-release-readiness.js",
        "events:smoke-db": "node scripts/smoke-events-database.js",
        "events:smoke-http": "node scripts/smoke-events-http-authenticated.js",
        "core:smoke-readonly": "node scripts/smoke-core-modules-readonly.js",
        "portal:readiness": "node scripts/inventory-supplier-portal-readiness.js",
        "catalog:bootstrap-suppliers": "node scripts/bootstrap-supplier-catalog.js",
        "suppliers:inventory-test": "node scripts/inventory-test-establishment-suppliers.js",
        "portal:create-test-user": "node scripts/create-test-supplier-portal-user.js",
        "portal:create-commercial-user": "node scripts/create-commercial-supplier-portal-user.js",
        "portal:smoke-price-submit": "node scripts/smoke-portal-price-submit.js",
        "catalog:smoke": "node scripts/smoke-organization-products.js",
        "catalog:reconcile": "node scripts/reconcile-organization-product-reviews.js",
        "clone-branch": "node scripts/cloneBranch.js"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "csv-parser": "^3.2.0",
        "dotenv": "^16.4.5",
        "dotenv-cli": "^11.0.0",
        "express": "^4.18.3",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "pdfkit": "^0.17.2",
        "react-hot-toast": "^2.6.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "nodemon": "^3.1.14",
        "prisma": "^5.22.0"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
